{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buffer_seconds"
  ],
  "properties": {
    "buffer_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615,
      "description": "Retention window of the rolling quantile summary, in seconds.",
      "x-busbar-public": true,
      "x-busbar-integer-token": "unsigned"
    },
    "key_gauge_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "default": 2000,
      "description": "Maximum per-key gauge series emitted by the host on each scrape.",
      "x-busbar-public": true,
      "x-busbar-integer-token": "unsigned"
    }
  },
  "x-busbar-settings-profile": "integer-token-v1"
}
